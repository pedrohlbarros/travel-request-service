{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "travel-request-service/app",
    "type": "project",
    "description": "Corporate travel request microservice.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-pcntl": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "ext-swoole": "*",
        "dedoc/scramble": "^0.13.53",
        "google/protobuf": "^5.36",
        "laravel/framework": "^13.40",
        "laravel/octane": "^2.23",
        "laravel/reverb": "^1.13",
        "lcobucci/jwt": "^5.6",
        "open-telemetry/exporter-otlp": "^1.5",
        "open-telemetry/opentelemetry-auto-laravel": "^1.10",
        "open-telemetry/sdk": "^1.16",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.35",
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.4",
        "ramsey/conventional-commits": "^1.7",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Domain\\": "src/Domain/",
            "Application\\": "src/Application/",
            "Infrastructure\\": "src/Infrastructure/",
            "Interfaces\\": "src/Interfaces/"
        },
        "files": [
            "bootstrap/telemetry.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\": "tools/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
