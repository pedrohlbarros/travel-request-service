# ---------------------------------------------------------------------------
# Host ports. Change any of these if the port is already taken on
# your machine (e.g. a local MySQL on 3306 -> FORWARD_DB_PORT=3307).
# Containers always talk to each other on the default internal ports.
# ---------------------------------------------------------------------------
FORWARD_APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_RABBITMQ_PORT=5672
FORWARD_RABBITMQ_UI_PORT=15672
FORWARD_MAILPIT_SMTP_PORT=1025
FORWARD_MAILPIT_UI_PORT=8025
FORWARD_REVERB_PORT=8080
FORWARD_GRAFANA_PORT=3000
FORWARD_JAEGER_UI_PORT=16686
FORWARD_PROMETHEUS_PORT=9090
FORWARD_LOKI_PORT=3100

# Container user, so files written through the bind mount belong to you (`id -u` / `id -g`).
UID=1000
GID=1000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Travel Request Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=debug

OCTANE_SERVER=swoole

# ---------------------------------------------------------------------------
# MySQL. DB_TEST_DATABASE is created on the first `make up`.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=travel_request
DB_TEST_DATABASE=travel_request_testing
DB_USERNAME=travel_request
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ---------------------------------------------------------------------------
# Redis: queue + cache. Session is unused (stateless API).
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# ---------------------------------------------------------------------------
# Identity: JWT signing keys are generated by `make keys` (outside git).
# Token lifetimes in seconds: access 15 min, refresh 7 days.
# ---------------------------------------------------------------------------
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=travel-request-service
JWT_PRIVATE_KEY_PATH=/var/www/html/storage/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/var/www/html/storage/keys/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
AUTH_RATE_LIMIT_PER_MINUTE=5

# ---------------------------------------------------------------------------
# Travel requests: read cache lifetimes in seconds (detail by id, lists).
# Writes drop what they change, so these only bound how long a list waits.
# ---------------------------------------------------------------------------
TRAVEL_REQUEST_CACHE_DETAIL_TTL=300
TRAVEL_REQUEST_CACHE_LIST_TTL=30

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=travel_request
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# Events: CloudEvents source, travel request exchange and the outbox relay
# (poll interval backs off from min to max while idle; batch size; seconds
# to wait for the broker to confirm a batch).
# ---------------------------------------------------------------------------
MESSAGING_EVENT_SOURCE=/travel-request-service
TRAVEL_REQUEST_EVENTS_EXCHANGE=travel_request.events
OUTBOX_RELAY_MIN_POLL_MS=200
OUTBOX_RELAY_MAX_POLL_MS=2000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_CONFIRM_TIMEOUT=5

# ---------------------------------------------------------------------------
# Notifications: the consumer of travel request decisions (queue, prefetch,
# retry delays in ms, one wait queue each) and the e-mail/notification locale.
# ---------------------------------------------------------------------------
NOTIFICATION_LOCALE=pt_BR
NOTIFICATION_QUEUE=notification.travel_request
NOTIFICATION_CONSUMER_PREFETCH=10
NOTIFICATION_RETRY_DELAYS_MS=10000,60000,300000

# ---------------------------------------------------------------------------
# Broadcast (Reverb). The app reaches the server as reverb:8080 inside
# Docker; browsers reach it on localhost:FORWARD_REVERB_PORT.
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=travel-request
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_SCHEME=http

# ---------------------------------------------------------------------------
# Mail -> Mailpit
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@travel-request.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# OpenTelemetry: traces, metrics and logs go to the Collector of the obs
# profile. `make obs` turns the SDK on (OTEL_SDK_DISABLED=false) for the app,
# relay and consumer; `make obs-down` turns it off again.
# ---------------------------------------------------------------------------
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=travel-request-service
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
OTEL_PHP_DETECTORS=host,process,service_instance
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TIMEOUT=2000
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRIC_EXPORT_INTERVAL=10000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
